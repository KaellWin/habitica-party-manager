# Aucune clé dans ce fichier. Utilisé par docker compose et par Portainer.
HPM_IMAGE=habitica-party-manager:0.1.0
HPM_ROOT=/srv/habitica-party-manager
# Nom EXACT d'un réseau Docker existant partagé avec le serveur API Habitica.
HABITICA_NETWORK=habitica_default
# Interface sur Ubuntu ; utiliser un tunnel SSH pour accéder à l'interface.
HPM_BIND_IP=127.0.0.1
HPM_PORT=8088
# Inclure le nom EXACT du backend interne si Docker configure un proxy sortant.
HPM_NO_PROXY=habitica-server,hpm.internal,localhost,127.0.0.1
